{
  "name": "dream-portal-qa-automation",
  "version": "1.0.0",
  "description": "Automated testing suite for Dream Portal using Playwright with Page Object Model, Allure reporting, and AI-based validation",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:home": "npx playwright test tests/home-page.spec.js",
    "test:diary": "npx playwright test tests/dream-diary.spec.js",
    "test:summary": "npx playwright test tests/dream-summary.spec.js",
    "test:ai": "npx playwright test tests/ai-validation.spec.js",
    "report": "npx playwright show-report",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report"
  },
  "keywords": ["playwright", "testing", "automation", "qa", "dream-portal"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "allure-playwright": "^3.12.2",
    "dotenv": "^18.0.3"
  }
}
